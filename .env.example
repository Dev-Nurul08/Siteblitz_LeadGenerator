# === SiteBlitz Lead Intelligence OS ===
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/siteblitz_leads
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/siteblitz_leads

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Source API Keys (add as needed)
# HUNTER_API_KEY=
# GOOGLE_PAGESPEED_API_KEY=

# Rate Limits (requests per minute)
OSM_OVERPASS_RPM=10
WIKIDATA_RPM=30
DEFAULT_CRAWL_RPM=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
